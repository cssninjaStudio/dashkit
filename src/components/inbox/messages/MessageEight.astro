<!-- Message details -->
<div
  x-show="activeMessage === 'message-8'"
  id="message-8"
  class="inbox-message-details"
  :class="{
        'mobile-active tablet-active': isMobileMessageActive,
        '': !isMobileMessageActive
    }"
>
  <div class="header-area">
    <img class="sender-pic" src="/img/avatars/nick.jpg" alt="" />
    <div class="message-meta">
      <span class="message-title">Customer dashboard february bug report</span>
      <span class="sender-email">&lt;nathan@Dashkit.io&gt;</span>
    </div>
    <div class="attachments inbox-hidden-mobile">
      <i class="sl icon-paper-clip"></i>
      <span>1</span>
    </div>
    <div
      x-ref="messagedrop8"
      @click.away="$refs.messagedrop8.classList.remove('is-active')"
      class="dropdown inbox-dropdown dropdown-trigger is-right"
    >
      <div>
        <button
          @click="$refs.messagedrop8.classList.add('is-active')"
          class="button"
        >
          <span class="icon is-small">
            <i class="sl icon-options"></i>
          </span>
        </button>
      </div>
      <div class="dropdown-menu">
        <div class="dropdown-content">
          <a class="dropdown-item">
            <i class="sl icon-star"></i>
            <span>Bookmark message</span>
          </a>
          <hr class="dropdown-divider" />
          <a class="dropdown-item">
            <i class="sl icon-share"></i>
            <span>Share message</span>
          </a>
          <hr class="dropdown-divider" />
          <a class="dropdown-item">
            <i class="sl icon-shield"></i>
            <span>Mark as spam</span>
          </a>
        </div>
      </div>
    </div>
    <a
      @click="closeMobileMessage()"
      class="inbox-action inbox-close-details-mobile"
    >
      <i class="material-icons">close</i>
    </a>
  </div>
  <!--Message-->
  <div class="message-wrapper has-slimscroll">
    <div class="message-inner">
      <div class="message-head">
        <div class="info">
          <span>Sent on</span>
          <span>Feb 18 2020, at 02:29pm</span>
        </div>
        <div class="message-actions">
          <a class="inbox-action">
            <i class="sl icon-action-undo"></i>
          </a>
          <a class="inbox-action">
            <i class="sl icon-docs"></i>
          </a>
          <a class="inbox-action">
            <i class="sl icon-tag"></i>
          </a>
          <a class="inbox-action">
            <i class="sl icon-bubble"></i>
          </a>
          <a class="inbox-action">
            <i class="sl icon-lock"></i>
          </a>
        </div>
      </div>
      <!--Mail Content-->
      <div class="mail-content content">
        <p>Hi,</p>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit.
          <a href="#" target="_blank"
            >Nunc haec primum fortasse audientis servire debemus.</a
          >
          At iste non dolendi status non vocatur voluptas. Quae duo sunt, unum facit.
          Etiam beatissimum? Haec quo modo conveniant, non sane intellego. Duo Reges:
          constructio interrete.
        </p>
        <ul>
          <li>Nam Pyrrho, Aristo, Erillus iam diu abiecti.</li>
          <li>
            Maximas vero virtutes iacere omnis necesse est voluptate dominante.
          </li>
        </ul>

        <p>Nick</p>
      </div>

      <!-- Attachments -->
      <div class="attachments-list">
        <div class="attachment">
          <span>report.pdf</span>
          <div class="download-icon">
            <i class="material-icons">arrow_downward</i>
          </div>
        </div>
      </div>
    </div>

    <!--Reply-->
    <div class="reply-box-wrap">
      <div class="reply-bubble">
        <div class="reply-as">
          <img src="/img/avatars/helen.jpg" alt="" />
          <div class="reply-details">
            <span>Reply as</span>
            <span>helenmiller@Dashkit.io</span>
          </div>
          <div
            x-ref="composedrop8"
            @click.away="$refs.composedrop8.classList.remove('is-active')"
            class="dropdown inbox-dropdown dropdown-trigger is-right"
          >
            <div>
              <button
                @click="$refs.composedrop8.classList.add('is-active')"
                class="button"
              >
                <span class="icon is-small">
                  <i class="sl icon-options"></i>
                </span>
              </button>
            </div>
            <div class="dropdown-menu">
              <div class="dropdown-content">
                <a class="dropdown-item">
                  <i class="sl icon-refresh"></i>
                  <span>Reset</span>
                </a>
                <hr class="dropdown-divider" />
                <a class="dropdown-item">
                  <i class="sl icon-book-open"></i>
                  <span>Spelling</span>
                </a>
                <hr class="dropdown-divider" />
                <a class="dropdown-item">
                  <i class="sl icon-mustache"></i>
                  <span>Mention</span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <!--textarea-->
        <div class="control">
          <textarea class="textarea" rows="6" placeholder="Type your message..."
          ></textarea>
          <button type="button" class="button">Send Message</button>
        </div>
      </div>
    </div>
  </div>
</div>
