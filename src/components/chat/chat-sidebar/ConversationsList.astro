<!-- User -->
<div
  @click="switchConversation($event)"
  class="user-item"
  data-chat-user="dan"
  data-full-name="Dan Walker"
  data-status="Online"
  data-picture="/img/avatars/dan.jpg"
  :class=`{
        'is-active': activeConversation === 'dan',
        '':  activeConversation != 'dan'
    }`
>
  <div class="avatar-container">
    <img class="user-avatar" src="/img/avatars/dan.jpg" alt="" />
    <div class="user-status is-online"></div>
  </div>
</div>
