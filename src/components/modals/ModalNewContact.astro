<!-- Create contact Modal -->
<div
  id="new-contact-modal"
  class="modal modal-lg create-contact-modal modal-hero"
  :class="{
    'is-active': newContactModalOpened,
    '': !newContactModalOpened
  }"
>
  <div @click="toggleNewContactModal()" class="modal-background"></div>
  <div class="modal-content">
    <div class="flex-card simple-shadow">
      <h2 class="title is-5">Create contact</h2>
      <div class="card-body">
        <div class="has-text-centered">
          <div class="image">
            <img src="/img/logo/square-violet.svg" alt="" />
          </div>
          <div class="help-text has-text-centered">
            Create a new contact by entering its basic details. You will then be
            able to edit it and to add more detailed informations.
          </div>

          <div class="columns is-multiline">
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="First Name"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-user"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="Last Name"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-user"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="Email address"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-envelope"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="Company"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-building"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="Position"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-briefcase"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="field">
                <div class="control has-icons-left">
                  <input
                    class="input is-medium"
                    type="text"
                    placeholder="Location"
                  />
                  <span class="icon is-left">
                    <i class="fa fa-map-marker"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="is-prospect">
            <div class="field">
              <label class="f-switch is-secondary scale-7">
                <input
                  id="prospectSwitch"
                  type="checkbox"
                  class="is-secondary"
                />
                <i></i>
              </label>
              <label for="prospectSwitch"
                ><span>is this contact a prospect?</span>
              </label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button
          @click="toggleNewContactModal()"
          type="button"
          class="button modal-dismiss">Cancel</button
        >
        <button type="submit" class="button is-modal">Create Contact</button>
      </div>
    </div>
  </div>
</div>
