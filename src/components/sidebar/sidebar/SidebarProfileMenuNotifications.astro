<!-- Profile notifications -->
<div x-show.transition="activeProfileTab === 'notifications-tab'" id="profile-notifications" class="profile-notifications">
  <div class="profile-notifications-inner animated preFadeInUp fadeInUp">
    <div class="profile-notifications-title">
      <h3>Notifications</h3>
      <span class="tag is-medium is-web">5 New</span>
    </div>

    <div class="card-body">
      <div class="notifications-center">
        <!-- Notification item -->
        <div class="profile-notification">
          <div class="notification-inner">
            <div class="icon is-hidden-mobile">
              <i class="im icon-Heart-2"></i>
            </div>
            <div class="description">
              <div class="timestamp">30 minutes ago</div>
              <span><b>5 users</b> liked your <b>publication</b> on the company's public blog</span>
            </div>
          </div>
        </div>
        <!-- Notification item -->
        <div class="profile-notification">
          <div class="notification-inner">
            <div class="icon is-hidden-mobile">
              <img src="/img/avatars/marc.jpg" alt="" />
            </div>
            <div class="description">
              <div class="timestamp">2 hours ago</div>
              <span><b>Marc Walters</b> commented on a <b>task</b>.</span>
            </div>
          </div>
        </div>
        <!-- Notification item -->
        <div class="profile-notification">
          <div class="notification-inner">
            <div class="icon is-hidden-mobile">
              <img src="/img/avatars/alex.jpg" alt="" />
            </div>
            <div class="description">
              <div class="timestamp">5 hours ago</div>
              <span
                ><b>3 new bugs</b> were reported by <b>Alex Walsh</b>, in the
                <b>Analytics App</b> project.</span
              >
            </div>
          </div>
        </div>
        <!-- Notification item -->
        <div class="profile-notification">
          <div class="notification-inner">
            <div class="icon is-hidden-mobile">
              <i class="im icon-Add"></i>
            </div>
