---
import SidebarProfileMenuCover from './SidebarProfileMenuCover.astro'
import SidebarProfileMenuDetails from './SidebarProfileMenuDetails.astro'
import SidebarProfileMenuTeam from './SidebarProfileMenuTeam.astro'
import SidebarProfileMenuNotifications from './SidebarProfileMenuNotifications.astro'
---

<!-- Profile wrapper -->
<ul class="profile">
  <li>
    <!-- Profile avatar -->
    <a class="profile-trigger" href="javascript:;" @click="toggleProfile()">
      <img
        class="main-menu-avatar"
        src="/img/avatars/helen.jpg"
        :class="{
            'vanish': $store.app.isProfileOpen,
            '': !$store.app.isProfileOpen
        }"
        alt=""
      />
      <span
        class="dot"
        :class="{
            'vanish': $store.app.isProfileOpen,
            '': !$store.app.isProfileOpen
        }"
      ></span>
    </a>

    <!-- Profile avatar -->
    <div
      class="special-fab js-hamburger"
      :class="{
          'is-active': $store.app.isProfileOpen,
          '': !$store.app.isProfileOpen
      }"
    >
      <!-- Profile page wrapper -->
      <div class="profile-container">
        <div class="inner">
          <SidebarProfileMenuCover />

          <!-- Profile Sections -->
          <div class="profile-sections-outer">
            <div class="profile-sections-wrapper">
              <SidebarProfileMenuDetails /> 
              
              <SidebarProfileMenuTeam /> 
              
              <SidebarProfileMenuNotifications />
            </div>
          </div>
        </div>
      </div>
      <!-- Profile page wrapper -->
      <div class="fab__ripple"></div>
      <div class="hamburger"></div>
    </div>
  </li>
</ul>
