<!-- Sidebar menu 4 -->
<ul
  id="misc-menu"
  class="sidebar-menu"
  :class="{
      'is-active': $store.app.activeSidebar == 'misc',
      '': !$store.app.activeSidebar != 'misc'
  }"
>
  <li
    class="have-children"
    @click="openSidebarMenu('misc-menu-2')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'misc-menu-2',
        '': !$store.app.activeSidebarMenu != 'misc-menu-2'
    }"
  >
    <a class="parent-link" href="javascript:">
      <span class="material-icons">apps</span>
      Apps
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'misc-menu-2'" x-collapse>
      <li><a href="datatable">Datatable</a></li>
      <li><a href="chat">Chat UI</a></li>
      <li><a href="inbox">Inbox UI</a></li>
    </ul>
  </li>
  <li
    class="have-children"
    @click="openSidebarMenu('misc-menu-3')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'misc-menu-3',
        '': !$store.app.activeSidebarMenu != 'misc-menu-3'
    }"
  >
    <a class="parent-link" href="javascript:">
      <span class="material-icons">thumbs_up_down</span>
      Forum
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'misc-menu-3'" x-collapse>
      <li><a href="forum-home">Forum Home</a></li>
      <li><a href="forum-channel">Forum Channel</a></li>
      <li><a href="forum-topic">Forum Topic</a></li>
    </ul>
  </li>
</ul>
