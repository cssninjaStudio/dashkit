<!-- Sidebar menu 1 -->
<ul
  id="dashboard-menu"
  class="sidebar-menu"
  :class="{
      'is-active': $store.app.activeSidebar == 'dashboard',
      '': !$store.app.activeSidebar != 'dashboard'
  }"
>
  <li
    class="have-children"
    @click="openSidebarMenu('dashboard-menu-1')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'dashboard-menu-1',
        '': !$store.app.activeSidebarMenu != 'dashboard-menu-1'
    }"
  >
    <a class="parent-link" href="javascript:;">
      <span class="material-icons">dashboard</span>
      Dashboard
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'dashboard-menu-1'" x-collapse>
      <li><a href="/dashboard">Main layout</a></li>
      <li><a href="/blank">Blank page</a></li>
    </ul>
  </li>
  <li
    class="have-children"
    @click="openSidebarMenu('dashboard-menu-2')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'dashboard-menu-2',
        '': !$store.app.activeSidebarMenu != 'dashboard-menu-2'
    }"
  >
    <a class="parent-link" href="javascript:;">
      <span class="material-icons">insert_chart</span>
      Analytics
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'dashboard-menu-2'" x-collapse>
      <li><a href="/charts-apex">Apex Charts</a></li>
    </ul>
  </li>
  <li
    class="have-children"
    @click="openSidebarMenu('dashboard-menu-3')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'dashboard-menu-3',
        '': !$store.app.activeSidebarMenu != 'dashboard-menu-3'
    }"
  >
    <a class="parent-link" href="javascript:;">
      <span class="material-icons">developer_board</span>
      Widgets
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'dashboard-menu-3'" x-collapse>
      <li><a href="/widgets-data">Data widgets</a></li>
      <li><a href="/widgets-social">Social widgets</a></li>
    </ul>
  </li>
  <li
    class="have-children"
    @click="openSidebarMenu('dashboard-menu-4')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'dashboard-menu-4',
        '': !$store.app.activeSidebarMenu != 'dashboard-menu-4'
    }"
  >
    <a class="parent-link" href="javascript:;">
      <span class="material-icons">view_agenda</span>
      Feed
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'dashboard-menu-4'" x-collapse>
      <li><a href="/feed-main">Social feed</a></li>
      <li><a href="/feed-post">Post Item</a></li>
    </ul>
  </li>
  <li
    class="have-children"
    @click="openSidebarMenu('dashboard-menu-5')"
    :class="{
        'active': $store.app.activeSidebarMenu == 'dashboard-menu-5',
        '': !$store.app.activeSidebarMenu != 'dashboard-menu-5'
    }"
  >
    <a class="parent-link" href="javascript:;">
      <span class="material-icons">account_circle</span>
      Auth
    </a>
    <ul x-show="$store.app.activeSidebarMenu == 'dashboard-menu-5'" x-collapse>
      <li><a href="/login">Login</a></li>
      <li><a href="/signup">Signup</a></li>
    </ul>
  </li>
</ul>
