---
import { version } from '../../package.json'
import Layout from '../layouts/Minimal.astro'
const title = 'Dashboard HTML Template'
---

<style is:global>
  body {
    background-color: var(--hero-bg-color) !important;
  }
</style>


<Layout title={title}>
  <!--Wrapper-->
  <div class="cssninja-product">
    <!--Navigation-->
    <div
      class="cssninja-nav"
      x-data="initNavbar()"
      x-init="initScrollAnchors()"
      x-on:scroll.window="scroll()"
      :class=`{
        'is-scrolled': scrolled,
        '': !scrolled,
        'is-solid': mobileOpen,
        '': !mobileOpen
      }`
    >
      <div class="cssninja-nav-inner">
        <div class="left">
          <img class="brand-logo light-image-block" src="/img/logo/dashkit-violet.svg" alt="Product logo" />
          <img class="brand-logo dark-image-block" src="/img/logo/dashkit-violet-dark.svg" alt="Product logo" />
          <span class="version">v{version}</span>
          <div class="nav-burger" @click="openMobileMenu()">
            <div class="menu-toggle">
              <div class="icon-box-toggle is-navbar" :class=`{
                    'active': mobileOpen,
                    '': !mobileOpen
                }`>
                <div class="rotate">
                  <i class="icon-line-top"></i>
                  <i class="icon-line-center"></i>
                  <i class="icon-line-bottom"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="right" :class=`{
              'is-active': mobileOpen,
              '': !mobileOpen
          }`>
          <a href="https://go.cssninja.io/buy-dashkit" class="nav-link">Product</a>
          <a href="#template-demos" class="nav-link scroll-link">Demos</a>
          <a href="https://go.cssninja.io/docs-dashkit" class="nav-link">Documentation</a>
          <label class="theme-toggle mask mask-blob">
            <input type="checkbox" x-on:change="toggleTheme()" :checked="$store.app.isDark" />
            <span class="theme-toggle-inner">
              <iconify-icon class="sun-icon iconify" icon="lucide:sun"></iconify-icon>
              <iconify-icon class="moon-icon iconify" icon="lucide:moon"></iconify-icon>
            </span>
          </label>
          <a href="https://go.cssninja.io/support-dashkit" class="button is-secondary is-long-1 raised">Support</a>
        </div>
      </div>
    </div>

    <!--Hero-->
    <div class="cssninja-hero">
      <div class="cssninja-hero-squares">
        <div class="cssninja-hero-squares-inner">
          <svg width="1640" height="1024" viewBox="0 0 1440 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_1232_2031)">
              <path
                d="M15.5 1024V0M79.5 1024V0M143.5 1024V0M207.5 1024V0M271.5 1024V0M335.5 1024V0M399.5 1024V0M463.5 1024V0M527.5 1024V0M591.5 1024V0M655.5 1024V0M719.5 1024V0M783.5 1024V0M847.5 1024V0M911.5 1024V0M975.5 1024V0M1039.5 1024V0M1103.5 1024V0M1167.5 1024V0M1231.5 1024V0M1295.5 1024V0M1359.5 1024V0M1423.5 1024V0M0 31.5H1440M0 95.5H1440M0 159.5H1440M0 223.5H1440M0 287.5H1440M0 351.5H1440M0 415.5H1440M0 479.5H1440M0 543.5H1440M0 607.5H1440M0 671.5H1440M0 735.5H1440M0 799.5H1440M0 863.5H1440M0 927.5H1440M0 991.5H1440"
                class="line"></path>
              <path d="M272 160H335V223H272V160Z" class="square"></path>
              <path d="M1168 800H1231V863H1168V800Z" class="square"></path>
              <path d="M528 96H591V159H528V96Z" class="square"></path>
              <path d="M1104 160H1167V223H1104V160Z" class="square"></path>
              <path d="M1232 352H1295V415H1232V352Z" class="square"></path>
              <path d="M1040 672H1103V735H1040V672Z" class="square"></path>
              <path d="M784 800H847V863H784V800Z" class="square"></path>
              <path d="M336 480H399V543H336V480Z" class="square"></path>
              <path d="M208 800H271V863H208V800Z" class="square"></path>
              <path d="M464 736H527V799H464V736Z" class="square"></path>
              <path d="M336 224H399V287H336V224Z" class="square"></path>
              <path d="M976 287H1039V350H976V287Z" class="square"></path>
              <path d="M720 864H783V927H720V864Z" class="square"></path>
              <path d="M1232 480H1295V543H1232V480Z" class="square"></path>
              <path d="M1168 544H1231V607H1168V544Z" class="square"></path>
              <path d="M784 224H847V287H784V224Z" class="square"></path>
              <path d="M208 352H271V415H208V352Z" class="square"></path>
              <path d="M272 608H335V671H272V608Z" class="square"></path>
              <path d="M144 480H207V543H144V480Z" class="square"></path>
              <path d="M848 32H911V95H848V32Z" class="square"></path>
              <path d="M528 352H591V415H528V352Z" class="square"></path>
              <path d="M912 480H975V543H912V480Z" class="square"></path>
            </g>
          </svg>
        </div>
      </div>
      <div class="container is-wide">
        <div class="cssninja-hero-inner">
          <div class="hero-caption mx-auto max-w-6">
            <h1 class="title is-1 is-bold is-spaced">Dashkit UI.</h1>
            <h3 class="subtitle is-5">Dashkit is a professional admin and dashboard UI template that will help you jumpstart your development project seamlessly.</h3>
            <div class="buttons is-centered">
              <a href="https://go.cssninja.io/buy-dashkit" class="button is-primary raised scroll-link">Buy Now</a>
            </div>
            <div class="product-stack product-stack-1">
              <img src="/img/stacks/html5-light.svg" alt="stack" />
            </div>
            <div class="product-stack product-stack-2">
              <img src="/img/stacks/astro-light.svg" class="light-image-block" alt="stack" />
              <img src="/img/stacks/astro-dark.svg" class="dark-image-block" alt="stack" />
            </div>
            <div class="product-stack product-stack-3">
              <img src="/img/stacks/alpinejs-light.svg" alt="stack" />
            </div>
            <div class="product-stack product-stack-4">
              <img src="/img/stacks/vite.svg" alt="stack" />
            </div>
            <div class="product-stack product-stack-5">
              <img src="/img/stacks/bulma-light.svg" alt="stack" />
            </div>
          </div>
        </div>
      </div>
      <img class="template-mockup light-image-block" src="/img/demo/dashkit-mockup-1.png" alt="Dashkit header image" />
      <img class="template-mockup dark-image-block" src="/img/demo/dashkit-mockup-1-dark.png" alt="Dashkit header image" />
    </div>

    <div class="section">
      <div class="container is-wide">
        <div class="cssninja-template">
          <div class="columns is-block-portrait">
            <div class="column is-8">
              <!--Template info-->
              <div class="template-info">
                <!--Section-->
                <div id="get-started" class="template-info-section">
                  <!--Section title-->
                  <div class="max-w-4 mb-5">
                    <h2 class="title is-3 is-medium is-leading">Built with</h2>
                    <p class="paragraph">
                      Although it is an HTML template, Dashkit relies on powerful stacks like Alpine JS v3.x and Bulma as a CSS framework, making you able to build beautiful apps.
                    </p>
                  </div>

                  <!--Stacks-->
                  <div class="template-stacks">
                    <div class="columns is-multiline b-columns-half-mobile b-columns-half-tablet-p">
                      <!--Stack-->
                      <div class="column is-6">
                        <div class="template-stack-card">
                          <iconify-icon class="iconify" icon="logos:astro-icon"></iconify-icon>
                          <div>
                            <h3 class="title is-6 is-narrow">Astro</h3>
                            <p class="paragraph rem-85">Version 4.x</p>
                          </div>
                        </div>
                      </div>
                      <!--Stack-->
                      <div class="column is-6">
                        <div class="template-stack-card">
                          <iconify-icon class="iconify" icon="devicon:alpinejs"></iconify-icon>
                          <div>
                            <h3 class="title is-6 is-narrow">Alpinejs</h3>
                            <p class="paragraph rem-85">Version 3.x</p>
                          </div>
                        </div>
                      </div>
                      <!--Stack-->
                      <div class="column is-6">
                        <div class="template-stack-card">
                          <iconify-icon class="iconify" icon="logos:bulma"></iconify-icon>
                          <div>
                            <h3 class="title is-6 is-narrow">Bulma</h3>
                            <p class="paragraph rem-85">Version 9.x</p>
                          </div>
                        </div>
                      </div>
                      <!--Stack-->
                      <div class="column is-6">
                        <div class="template-stack-card">
                          <iconify-icon class="iconify" icon="logos:vitejs"></iconify-icon>
                          <div>
                            <h3 class="title is-6 is-narrow">Vite</h3>
                            <p class="paragraph rem-85">Version 4.x</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!--Section-->
                <div class="template-info-section">
                  <!--Section title-->
                  <div class="max-w-4 mb-5">
                    <h2 class="title is-3 is-medium is-leading">Features</h2>
                    <p class="paragraph">Dashkit ships with a lot of features to make your developer and customer experiences as nice as possible, without the hassle and unecessary effort.</p>
                  </div>

                  <!--Features-->
                  <div class="template-features">
                    <div class="columns is-multiline b-columns-half-mobile b-columns-third-tablet-p">
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:grid-3-2"></iconify-icon>
                          <h3 class="title is-6 is-leading">Modern UI</h3>
                          <p class="paragraph rem-90">A clean, well designed and well integrated UI for your app.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:keyboard"></iconify-icon>
                          <h3 class="title is-6 is-leading">Clean code</h3>
                          <p class="paragraph rem-90">A clean code structure is there to help you with your workflow.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:palette"></iconify-icon>
                          <h3 class="title is-6 is-leading">Easy Theming</h3>
                          <p class="paragraph rem-90">Zod uses native CSS variables and makes theming super easy.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:dark"></iconify-icon>
                          <h3 class="title is-6 is-leading">Native dark mode</h3>
                          <p class="paragraph rem-90">Zod ships with dark mode for all components out of the box.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:globe"></iconify-icon>
                          <h3 class="title is-6 is-leading">RTL support</h3>
                          <p class="paragraph rem-90">Zod supports RTL based layouts, just switch the stylesheet.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:lock"></iconify-icon>
                          <h3 class="title is-6 is-leading">GitHub access</h3>
                          <p class="paragraph rem-90">We grant you access to the private GitHub repo for live updates.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:timer"></iconify-icon>
                          <h3 class="title is-6 is-leading">Lifetime updates</h3>
                          <p class="paragraph rem-90">You're entitled to receive lifetime updates for this product.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:folder-on"></iconify-icon>
                          <h3 class="title is-6 is-leading">Documentation</h3>
                          <p class="paragraph rem-90">An extensive documentation helps you setting up everything.</p>
                        </div>
                      </div>
                      <!--Feature-->
                      <div class="column is-4">
                        <div class="template-feature">
                          <iconify-icon class="iconify" icon="circum:medal"></iconify-icon>
                          <h3 class="title is-6 is-leading">Support</h3>
                          <p class="paragraph rem-90">A dedicated customer support portal to post your requests.</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!--Section-->
                <div class="template-info-section">
                  <!--Section title-->
                  <div class="max-w-4 mb-5">
                    <h2 class="title is-3 is-medium is-leading">Demo Pages</h2>
                    <p class="paragraph">Dashkit ships with more than 39 superb demo pages to help you get started as fast as possible, and build an outstanding and memorable project.</p>
                  </div>

                  <!--Template demos-->
                  <div id="template-demos" class="template-demos" x-data="initRenderDemos()">
                    <div class="columns is-multiline b-columns-third-tablet-p">
                      <template x-for="screenshot in screenshots">
                        <div class="column is-6 has-text-centered">
                          <figure class="demo-wrapper">
                            <template x-if="screenshot.new">
                              <span class="new-tag">New</span>
                            </template>

                            <div class="image-wrapper">
                              <img class="light-image-block" x-bind:data-src="screenshot.screenshotLight" alt="screenshot light image" data-lazy-load />
                              <img class="dark-image-block" x-bind:data-src="screenshot.screenshotDark" alt="screenshot dark image" data-lazy-load />
                            </div>

                            <div class="circle-overlay is-landing"></div>
                            <div class="demo-info has-text-centered">
                              <div class="wrapper">
                                <div class="demo-title" x-text="screenshot.name"></div>
                                <div class="demo-link">
                                  <a class="is-dm" x-bind:href="screenshot.link" target="_blank"
                                    >Go to demo
                                    <i class="iconify" data-icon="ph:arrow-right-bold"></i></a
                                  >
                                </div>
                              </div>
                            </div>
                          </figure>
                        </div>
                      </template>
                    </div>
                  </div>
                </div>

                <!--Section-->
                <div class="template-info-section">
                  <!--Section title-->
                  <div class="max-w-4 mb-5">
                    <h2 class="title is-3 is-medium is-leading">FAQs</h2>
                    <p class="paragraph">You probably already have a lot of questions. You can open a support ticket, or read some answers to the most common questions asked by our customers.</p>
                  </div>

                  <!--Template FAQ-->
                  <div class="template-faq">
                    <div class="columns">
                      <div class="column">
                        <div class="accordion" x-data="initAccordion()" x-init="setup()">
                          <div class="accordion-item">
                            <button id="accordion-button-1" aria-expanded="false">
                              <span class="accordion-title">What is the difference between your licenses?</span><span class="icon" aria-hidden="true"></span>
                            </button>
                            <div class="accordion-content">
                              <p>
                                The main difference between our licenses is the number and type of projects that you can build with our templates. There are also some special perks that come with
                                upper licenses. The
                                <a href="https://cssninja.io/about/license-starter">starter license</a>
                                allows you to build a single project with limited support from the discord community. However, if you are a professional developer or a freelancer, you might consider purchasing
                                a
                                <a href="https://cssninja.io/about/license-developer">developer license</a>, granting you access to the Github repository, and allowing you to build SaaS projects, or
                                the
                                <a href="https://cssninja.io/about/license-business">business license</a>, which allows unlimited projects, building complex SaaS products and access to private member
                                areas and special sales.
                              </p>
                            </div>
                          </div>
                          <div class="accordion-item">
                            <button id="accordion-button-2" aria-expanded="false">
                              <span class="accordion-title">What about licensing and SaaS projects?</span><span class="icon" aria-hidden="true"></span>
                            </button>
                            <div class="accordion-content">
                              <p>
                                Unlike other platforms, it doesn't matter to us if your customers will need to pay to get access to your product. You can build SaaS products with our templates
                                starting from the
                                <a href="https://cssninja.io/about/license-developer">developer license</a>
                                and the
                                <a href="https://cssninja.io/about/license-business">business license</a>. Take the time to check each license for details about usage.
                              </p>
                            </div>
                          </div>
                          <div class="accordion-item">
                            <button id="accordion-button-3" aria-expanded="false">
                              <span class="accordion-title">What about theme customization?</span><span class="icon" aria-hidden="true"></span>
                            </button>
                            <div class="accordion-content">
                              <p>
                                Theme customization is not part of our regular services and therefore not included in a product purchase. If you need customization services, feel free to reach us and
                                make sure to send us your requirements so we can issue a quote for you or your company.
                              </p>
                            </div>
                          </div>
                          <div class="accordion-item">
                            <button id="accordion-button-4" aria-expanded="false">
                              <span class="accordion-title">What about the support scope?</span><span class="icon" aria-hidden="true"></span>
                            </button>
                            <div class="accordion-content">
                              <p>
                                Our support guidelines are very clear. We only support what is directly related to the template UI. Anything else remains optional. We do not support 3rd party plugins
                                as well though we can provide some guidance on how to use them best, but not on how to implement them or fix your own implementation.
                              </p>
                            </div>
                          </div>
                          <div class="accordion-item">
                            <button id="accordion-button-5" aria-expanded="false">
                              <span class="accordion-title">Can I be refunded if Iam not happy?</span><span class="icon" aria-hidden="true"></span>
                            </button>
                            <div class="accordion-content">
                              <p>
                                If the product doesn't suit your needs you can always ask us to get a refund under 14 days after product purchase. After, that delay you won't be eligible for a refund
                                anymore. Refund requests should always explain why you are returning the product.
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="column is-4">
              <div x-data="initPurchaseCard()" class="purchase-card">
                <div class="purchase-card-tabs">
                  <div class="inner-tabs">
                    <a data-tab="starter" @click.prevent="toggleTabs($event)" :class=`{
                        'is-active': activeTab === 'starter'
                      }`>Starter</a>
                    <a data-tab="developer" @click.prevent="toggleTabs($event)" :class=`{
                        'is-active': activeTab === 'developer'
                      }`>Developer</a>
                    <a data-tab="business" @click.prevent="toggleTabs($event)" :class=`{
                        'is-active': activeTab === 'business'
                      }`>Business</a>
                    <span class="naver"></span>
                  </div>

                  <div class="inner-tabs-content">
                    <div class="inner-content">
                      <!--Starter price-->
                      <div x-show="activeTab === 'starter'" class="price-block">
                        <h3 class="price-value">$39</h3>
                        <div class="price-meta">
                          <h4>Starter license</h4>
                          <p class="paragraph rem-85">Use this template on a single domain / subdomain.</p>
                        </div>
                      </div>

                      <!--Developer price-->
                      <div x-show="activeTab === 'developer'" class="price-block">
                        <h3 class="price-value">$59</h3>
                        <div class="price-meta">
                          <h4>Developer license</h4>
                          <p class="paragraph rem-85">Same as starter license with private Github access.</p>
                        </div>
                      </div>

                      <!--Business price-->
                      <div x-show="activeTab === 'business'" class="price-block">
                        <h3 class="price-value">$149</h3>
                        <div class="price-meta">
                          <h4>Business license</h4>
                          <p class="paragraph rem-85">Use this template on unlimited domains / subdomains.</p>
                        </div>
                      </div>

                      <!--Benefits-->
                      <div class="benefits">
                        <ul>
                          <li x-show="activeTab !== 'business'">
                            <span>Up to 1 domain / subdomain</span>
                          </li>
                          <li x-show="activeTab === 'business'">
                            <span>Unlimited domains / subdomains</span>
                          </li>
                          <li :class=`{
                              'text-linethrough is-disabled': activeTab === 'starter'
                            }`>
                            <span>Access to Github repository</span>
                          </li>
                          <li>
                            <span>Lifetime updates</span>
                          </li>
                          <li x-show="activeTab !== 'starter'">
                            <span>6 months included support</span>
                          </li>
                          <li x-show="activeTab === 'starter'">
                            <span>Community support</span>
                          </li>
                        </ul>
                      </div>

                      <!--Action-->
                      <div class="purchase-action">
                        <a href="https://go.cssninja.io/buy-dashkit" class="button is-primary is-fullwidth raised">Purchase Now</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section template-cta">
      <div class="cssninja-hero-squares">
        <div class="cssninja-hero-squares-inner">
          <svg width="1640" height="1024" viewBox="0 0 1440 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_1232_2031)">
              <path
                d="M15.5 1024V0M79.5 1024V0M143.5 1024V0M207.5 1024V0M271.5 1024V0M335.5 1024V0M399.5 1024V0M463.5 1024V0M527.5 1024V0M591.5 1024V0M655.5 1024V0M719.5 1024V0M783.5 1024V0M847.5 1024V0M911.5 1024V0M975.5 1024V0M1039.5 1024V0M1103.5 1024V0M1167.5 1024V0M1231.5 1024V0M1295.5 1024V0M1359.5 1024V0M1423.5 1024V0M0 31.5H1440M0 95.5H1440M0 159.5H1440M0 223.5H1440M0 287.5H1440M0 351.5H1440M0 415.5H1440M0 479.5H1440M0 543.5H1440M0 607.5H1440M0 671.5H1440M0 735.5H1440M0 799.5H1440M0 863.5H1440M0 927.5H1440M0 991.5H1440"
                class="line"></path>
              <path d="M272 160H335V223H272V160Z" class="square"></path>
              <path d="M1168 800H1231V863H1168V800Z" class="square"></path>
              <path d="M528 96H591V159H528V96Z" class="square"></path>
              <path d="M1104 160H1167V223H1104V160Z" class="square"></path>
              <path d="M1232 352H1295V415H1232V352Z" class="square"></path>
              <path d="M1040 672H1103V735H1040V672Z" class="square"></path>
              <path d="M784 800H847V863H784V800Z" class="square"></path>
              <path d="M336 480H399V543H336V480Z" class="square"></path>
