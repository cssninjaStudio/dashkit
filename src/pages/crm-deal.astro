---
import Layout from '../layouts/Default.astro'
const title = 'Deal Details'
---

<Layout title={title}>
  <!-- Main dashboard container -->
  <div
    id="dashboard-wrapper"
    class="dashboard-outer"
    x-data="initCrmDeal()"
    x-init="initDatePicker()"
    :class=`{
        'is-pushed': $store.app.sidebarOpenedState,
        '': !$store.app.sidebarOpenedState
    }`
  >
    <div class="dashboard-inner">
      <!-- Dashboard Wrapper -->
      <div class="dashboard-wrapper">
        <div id="main-dashboard" class="section-wrapper">
          <!-- Dashboard content -->
          <div class="dashboard-columns">
            <!-- Page title -->
            <div class="deal-title-wrapper is-mobile">
              <img class="deal-image" src="/img/logo/companies/airbnb.svg" alt="" />
              <div class="inner-wrap">
                <h3 class="deal-title">Airbnb Deal</h3>
                <div class="title-meta">
                  <div class="meta">
                    <i class="material-icons">person</i>
                    <span>Jeff Stockton</span>
                  </div>
                  <div class="meta">
                    <i class="material-icons">domain</i>
                    <span>Airbnb</span>
                  </div>
                </div>
              </div>
              <!-- Filter input -->
              <div class="actions">
                <a class="button is-secondary is-raised ripple ripple-light" data-ripple-color=""> Won </a>

                <a class="button ripple" data-ripple-color=""> Lost</a>
              </div>
            </div>
            <!-- Stage -->
            <div class="stage-wrapper">
              <div class="stage-inner">
                <progress class="progress is-small" value="35" max="100"> 35% </progress>
              </div>
              <div class="stages">
                <div class="stage is-done">
                  <span><i class="sl icon-check"></i>Prospect</span>
                </div>
                <div class="stage">
                  <span><i class="sl icon-check"></i>Reached</span>
                </div>
                <div class="stage">
                  <span><i class="sl icon-check"></i>Qualified</span>
                </div>
                <div class="stage">
                  <span><i class="sl icon-check"></i>Negociation</span>
                </div>
                <div class="stage">
                  <span><i class="sl icon-check"></i>End</span>
                </div>
              </div>
            </div>
            <!-- Deal meta -->
            <div class="deal-meta">
              <div class="deal-price">
                <span>$8,500.00</span>
                <span>16 products</span>
              </div>
              <!-- Deal owner -->
              <div class="deal-owner">
                <img src="/img/avatars/melany.jpg" alt="" />
                <div class="owner-meta">
                  <span>Melany Smith</span>
                  <span>Deal owner</span>
                </div>
                <!-- Menu -->
                <div x-ref="dealdrop1" @click.away="$refs.dealdrop1.classList.remove('is-active')" class="dropdown is-right dropdown-trigger styled-dropdown is-round">
                  <div @click="$refs.dealdrop1.classList.add('is-active')" class="button">
                    <i class="material-icons">keyboard_arrow_down</i>
                  </div>
                  <div class="dropdown-menu is-text-bigger has-text-left" role="menu">
                    <div class="dropdown-content">
                      <a class="dropdown-item">
                        <i class="sl icon-people"></i>
                        <span>
                          <span>Reassign</span>
                          <span>Reassign this deal</span>
                        </span>
                      </a>
                      <a href="#" class="dropdown-item">
                        <i class="sl icon-arrow-left-circle"></i>
                        <span>
                          <span>Cancel</span>
                          <span>Cancel this deal</span>
                        </span>
                      </a>
                      <div class="dropdown-divider"></div>
                      <a href="#" class="dropdown-item">
                        <i class="sl icon-equalizer"></i>
                        <span>
                          <span>Settings</span>
                          <span>Edit deal settings</span>
                        </span>
                      </a>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item">
                        <i class="sl icon-clock"></i>
                        <span>
                          <span>Suspend</span>
                          <span>Suspend this deal</span>
                        </span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Deal content -->
            <div class="deal-content">
              <div class="columns">
                <!-- Left side -->
                <div class="column is-4">
                  <!-- Deal details -->
                  <div class="deal-card">
                    <div
                      class="deal-card-header is-toggle"
                      @click="detailsPanelOpened = !detailsPanelOpened"
                      :class=`{
                          'is-active': detailsPanelOpened,
                          '': !detailsPanelOpened,
                      }`
                    >
                      <h3>Details</h3>
                      <div class="toggle-icon">
                        <i class="material-icons">keyboard_arrow_right</i>
                      </div>
                    </div>
                    <div x-show="detailsPanelOpened" class="deal-card-content" x-collapse>
                      <div class="details-placeholder">
                        <span>What do you know about this deal?</span>
                        <a><i class="material-icons">add</i> Add more details</a>
                      </div>
                    </div>
                  </div>
                  <!-- Deal contact -->
                  <div class="deal-card">
                    <div
                      class="deal-card-header is-toggle"
                      @click="contactPanelOpened = !contactPanelOpened"
                      :class=`{
                          'is-active': contactPanelOpened,
                          '': !contactPanelOpened,
                      }`
                    >
                      <h3>Contact</h3>
                      <div class="toggle-icon">
                        <i class="material-icons">keyboard_arrow_right</i>
                      </div>
                    </div>
                    <div x-show="contactPanelOpened" class="deal-card-content" x-collapse>
                      <!-- Deal contact -->
                      <div class="deal-contact">
                        <img src="/img/avatars/ray.jpg" alt="" />
                        <div class="contact-meta">
                          <span>Jeff Stockton</span>
                          <span>Airbnb</span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-briefcase"></i>
                        </div>
                        <div class="block-meta">
                          <span>Job title</span>
                          <span>CEO</span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-phone"></i>
                        </div>
                        <div class="block-meta">
                          <span>Phone</span>
                          <span><a>+1 555-321-28</a></span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-envelope-open"></i>
                        </div>
                        <div class="block-meta">
                          <span>Email</span>
                          <span><a>johnstockton@airbnb.com</a></span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block is-add top-spaced">
                        <div class="block-icon">
                          <i class="material-icons">add</i>
                        </div>
                        <div class="block-meta">
                          <span>Add</span>
                          <span>Add additional details</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Deal organization -->
                  <div class="deal-card">
                    <div
                      class="deal-card-header is-toggle"
                      @click="organisationPanelOpened = !organisationPanelOpened"
                      :class=`{
                          'is-active': organisationPanelOpened,
                          '': !organisationPanelOpened,
                      }`
                    >
                      <h3>Organization</h3>
                      <div class="toggle-icon">
                        <i class="material-icons">keyboard_arrow_right</i>
                      </div>
                    </div>
                    <div x-show="organisationPanelOpened" class="deal-card-content" x-collapse>
                      <!-- Deal contact -->
                      <div class="deal-contact">
                        <img src="/img/logo/companies/airbnb.svg" alt="" />
                        <div class="contact-meta">
                          <span>Airbnb</span>
                          <span>Flat Rental</span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-briefcase"></i>
                        </div>
                        <div class="block-meta">
                          <span>Job title</span>
                          <span>CEO</span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-phone"></i>
                        </div>
                        <div class="block-meta">
                          <span>Phone</span>
                          <span><a>+1 555-321-28</a></span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block top-spaced">
                        <div class="block-icon">
                          <i class="sl icon-envelope-open"></i>
                        </div>
                        <div class="block-meta">
                          <span>Email</span>
                          <span><a>johnstockton@airbnb.com</a></span>
                        </div>
                      </div>
                      <!-- Info block -->
                      <div class="info-block is-add top-spaced">
                        <div class="block-icon">
                          <i class="material-icons">add</i>
                        </div>
                        <div class="block-meta">
                          <span>Add</span>
                          <span>Add additional details</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Right side -->
                <div class="column is-8">
                  <!-- Action card -->
                  <div class="flex-card action-card card-overflow">
                    <!-- Header -->
                    <div class="action-card-header">
                      <!-- Write note action -->
                      <div
                        class="action"
                        @click="toggleActionTabs('note-tab')"
                        :class=`{
                            'is-active': activeActionTab === 'note-tab',
                            '': activeActionTab !== 'note-tab',
                        }`
                      >
                        <i class="sl icon-doc"></i>
                        <span>Write a note</span>
                        <div class="arrow-down"></div>
                      </div>
                      <!-- Schedule event action -->
                      <div
                        class="action"
                        class="action"
                        @click="toggleActionTabs('event-tab')"
                        :class=`{
                            'is-active': activeActionTab === 'event-tab',
                            '': activeActionTab !== 'event-tab',
                        }`
                      >
                        <i class="sl icon-clock"></i>
                        <span>Schedule event</span>
                        <div class="arrow-down"></div>
                      </div>
                      <!-- Upload files action -->
                      <div
                        class="action"
                        class="action"
                        @click="toggleActionTabs('file-tab')"
                        :class=`{
                            'is-active': activeActionTab === 'file-tab',
                            '': activeActionTab !== 'file-tab',
                        }`
                      >
                        <i class="sl icon-paper-clip"></i>
                        <span>Upload files</span>
                        <div class="arrow-down"></div>
                      </div>
                    </div>
                    <!-- Body -->
                    <div class="action-card-body">
                      <!-- Write note -->
                      <div x-show.transition="activeActionTab === 'note-tab'" class="action-wrap">
                        <div class="control">
                          <textarea class="textarea" rows="1" placeholder="Click here to write a Note ..."></textarea>
                        </div>
                      </div>
                      <!-- Schedule event -->
                      <div x-show.transition="activeActionTab === 'event-tab'" class="action-wrap">
                        <!-- Form -->
                        <form class="event-form">
                          <h3 class="action-title">New Event</h3>
                          <div class="columns is-multiline">
                            <div class="column is-6">
                              <!-- event type select -->
                              <div class="control is-combo">
                                <div class="combo-label">Event Type</div>
                                <div
                                  @click="openEventCombo()"
                                  @click.away="closeEventCombo()"
                                  class="combo-box"
                                  :class=`{
                                      'is-active': eventComboOpened,
                                      '': !eventComboOpened,
                                  }`
                                >
                                  <div class="box-inner">
                                    <div class="combo-item">
                                      <i :class="eventComboIcon"></i>
                                      <span x-text="eventComboText" class="selected-item">Conference Call</span>
                                    </div>
                                  </div>
                                  <div class="box-chevron">
                                    <i class="material-icons">keyboard_arrow_down</i>
                                  </div>
                                  <div class="box-dropdown">
                                    <div class="dropdown-inner has-slimscroll">
                                      <ul>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Phone-2" data-text="Phone Call">
                                          <span class="item-icon">
                                            <i class="im icon-Phone-2"></i>
                                          </span>
                                          <span class="item-name">Phone Call</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Conference" data-text="Conference Call">
                                          <span class="item-icon">
                                            <i class="im icon-Conference"></i>
                                          </span>
                                          <span class="item-name">Conference Call</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Cinema" data-text="Business Conference">
                                          <span class="item-icon">
                                            <i class="im icon-Cinema"></i>
                                          </span>
                                          <span class="item-name">Business Conference</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Pipette" data-text="Test Session">
                                          <span class="item-icon">
                                            <i class="im icon-Pipette"></i>
                                          </span>
                                          <span class="item-name">Test Session</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Note" data-text="Project Review">
                                          <span class="item-icon">
                                            <i class="im icon-Note"></i>
                                          </span>
                                          <span class="item-name">Project Review</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateEventCombo($event)" data-icon="im icon-Professor" data-text="Interview">
                                          <span class="item-icon">
                                            <i class="im icon-Professor"></i>
                                          </span>
                                          <span class="item-name">Interview</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                      </ul>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <!-- Event date -->
                              <div class="field deal-field">
                                <label class="grey-label-compact">When is the event?</label>
                                <div class="control">
                                  <input type="text" class="input event-datepicker" placeholder="Pick a date" />
                                  <div class="form-icon">
                                    <i class="im icon-Calendar-4"></i>
                                  </div>
                                </div>
                              </div>
                              <!-- Event Start -->
                              <div class="field deal-field">
                                <label class="grey-label-compact">Starts at</label>
                                <div class="control">
                                  <input type="text" class="input" />
                                  <div class="form-icon">
                                    <i class="im icon-Clock-Forward"></i>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <div class="column is-6">
                              <!-- Participants select -->
                              <div class="control is-combo">
                                <div class="combo-label">Participants</div>
                                <div
                                  class="stacked-combo-box has-rounded-images"
                                  @click="openParticipantsCombo()"
                                  @click.away="closeParticipantsCombo()"
                                  class="combo-box"
                                  :class=`{
                                      'is-active': participantsComboOpened,
                                      '': !participantsComboOpened,
                                  }`
                                >
                                  <div class="box-inner">
                                    <div x-html="participantsComboState" class="combo-item"></div>
                                  </div>
                                  <div class="box-chevron">
                                    <i class="material-icons">keyboard_arrow_down</i>
                                  </div>
                                  <div class="box-dropdown">
                                    <div class="dropdown-inner has-slimscroll">
                                      <ul>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/ray.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/ray.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Jeff Stockton</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/melany.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/melany.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Melany Smith</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/helen.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/helen.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Helen Miller</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/kareem.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/kareem.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Kareem Jabbar</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/terry.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/terry.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Terry Daniels</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/elie.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/elie.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Elie Brock</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/nick.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/nick.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Nick Schwartz</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/lakisha.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/lakisha.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Lakisha Williams</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                        <li @click="updateParticipantsCombo($event)" data-src="/img/avatars/alan.jpg">
                                          <span class="item-icon">
                                            <img src="/img/avatars/alan.jpg" alt="" />
                                          </span>
                                          <span class="item-name">Alan Maynard</span>
                                          <span class="checkmark">
                                            <i class="material-icons">done</i>
                                          </span>
                                        </li>
                                      </ul>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <!-- Full day -->
                              <div class="field deal-field">
                                <label class="grey-label-compact">Full day event?</label>
                                <div class="control is-flex">
                                  <label class="custom-checkbox scale-9">
                                    <input type="checkbox" checked />
                                    <span class="toggler">
                                      <span class="active">
                                        <i class="material-icons">done</i>
                                      </span>
                                      <span class="inactive">
                                        <i class="material-icons">close</i>
                                      </span>
                                    </span>
                                  </label>
                                  <span class="checkbox-label">Is this a full day event ?</span>
                                </div>
                              </div>
                              <!-- Event End -->
                              <div class="field deal-field">
                                <label class="grey-label-compact">Ends at</label>
                                <div class="control">
                                  <input type="text" class="input timepicker-24" placeholder="set time" />
                                  <div class="form-icon">
                                    <i class="im icon-Clock-Forward"></i>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <div class="column is-12 is-spaced">
                              <!-- Event Description -->
                              <div class="field deal-field">
                                <label class="grey-label-compact">Description</label>
                                <div class="control">
                                  <textarea class="textarea" rows="1" placeholder="Describe the event..."></textarea>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div class="button-wrap">
                            <button class="button is-secondary is-raised is-rounded ripple ripple-light" data- ripple-light-color=""> Create Event </button>
                          </div>
                        </form>
                      </div>

                      <div x-show.transition="activeActionTab === 'file-tab'" class="action-wrap">
                        <form>
                          <div class="control">
                            <div class="control attachments-field">
                              <div class="controls">
                                <div id="messageFiles" class="message-files">
                                  <div class="upload-box">
                                    <input name="files[]" type="file" />
                                    <label class="upload-box-inner">
                                      <i class="fas fa-plus"></i>
                                    </label>
                                    <div class="preview-box is-hidden">
                                      <div class="delete"></div>
                                      <img alt="" />
                                    </div>
                                  </div>
                                </div>
                                <div class="add-more-files">
                                  <a href="javascript:;" class="add-file-input">
                                    <i class="fas fa-plus"></i>
                                    <span>Attach another file</span>
                                  </a>
                                </div>
                              </div>
                            </div>
                            <div class="button-wrap">
                              <div class="control">
                                <textarea class="textarea" rows="1" placeholder="A quick note about these files..."></textarea>
                              </div>
                              <button type="submit" class="button is-secondary is-raised is-rounded ripple ripple-light" data-ripple-color=""> Upload </button>
                            </div>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Timeline separator -->
                  <div class="timeline-separator">
                    <span>Scheduled</span>
                  </div>
                  <!-- Timeline section -->
                  <div class="deal-timeline">
                    <ul>
                      <li class="is-scheduled">
                        <div class="timeline-icon">
                          <i class="material-icons">people</i>
                        </div>
                        <div class="timeline-item">
                          <div class="item-body">
                            <h3>Meeting with Jeff</h3>
                            <div class="meta-list">
                              <div class="meta-list-item">
                                <span class="is-thin">Tomorrow at 03:00pm with Melany Smith</span>
                              </div>
                            </div>
                            <div class="meta-list">
                              <div class="meta-list-item">
                                <i class="material-icons">person</i>
                                <span>Jeff Markstrom</span>
                              </div>
                              <div class="meta-list-item">
                                <i class="material-icons">domain</i>
                                <span>Airbnb</span>
                              </div>
                            </div>
                          </div>
                          <div class="item-footer">
                            <p>Meeting to discuss the future marketing campaign</p>
                          </div>
                        </div>
                      </li>
                    </ul>
                  </div>
                  <!-- Timeline separator -->
                  <div class="timeline-separator is-spaced">
                    <span>History</span>
                  </div>
                  <!-- Past timeline -->
                  <div class="navigation-tabs animated-tabs simple-tabs">
                    <!-- Tabs -->
                    <div class="tabs is-centered">
                      <ul>
                        <li
                          @click="toggleBusinessTabs('all-tab')"
                          :class=`{
                              'is-active': activeBusinessTab === 'all-tab',
                              '': activeBusinessTab !== 'all-tab',
                          }`
                        >
                          <a>All</a>
                        </li>
                        <li
                          @click="toggleBusinessTabs('activities-tab')"
                          :class=`{
                              'is-active': activeBusinessTab === 'activities-tab',
