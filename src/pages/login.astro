---
import Layout from "../layouts/Auth.astro";
const title = 'Login'
---

<Layout title={title}>
  <div class="auth-wrapper is-single">
    <!--Fake navigation-->
    <div class="auth-nav">
      <div class="left"></div>
      <div class="center">
        <a href="/" class="header-item">
          <img
            class="light-image-block"
            src="/img/logo/dashkit-violet.svg"
            alt=""
          />
          <img
            class="dark-image-block"
            src="/img/logo/dashkit-violet-dark.svg"
            alt=""
          />
        </a>
      </div>
      <div class="right"></div>
    </div>

    <!--Single Centered Form-->
    <div class="single-form-wrap">
      <div class="inner-wrap">
        <!--Form Title-->
        <div class="auth-head">
          <h2>Welcome Back.</h2>
          <p>Please sign in to your account</p>
          <a href="/signup">I do not have an account yet</a>
        </div>

        <!--Form-->
        <div class="form-card">
          <form>
            <div id="signin-form" class="login-form">
              <!-- Input -->
              <div class="field">
                <div class="control has-icon">
                  <input class="input" type="text" placeholder="Username" />
                  <span class="form-icon">
                    <i data-feather="user"></i>
                  </span>
                </div>
              </div>
              <!-- Input -->
              <div class="field">
                <div class="control has-icon">
                  <input class="input" type="password" placeholder="Password" />
                  <span class="form-icon">
                    <i data-feather="lock"></i>
                  </span>
                </div>
              </div>

              <div class="setting-item is-flex is-align-items-center mb-3">
                <label class="f-switch is-secondary scale-8">
                  <input
                    type="checkbox"
                    class="is-switch"
                    id="busy-mode-toggle"
                  />
                  <i></i>
                </label>
                <div class="setting-meta">
                  <span class="is-font text-light">Remember Me</span>
                </div>
              </div>

              <!-- Submit -->
              <div class="control login">
                <button
                  class="button is-secondary is-medium is-fullwidth is-raised"
                >
                  Sign In
                </button>
              </div>
            </div>
          </form>
        </div>

        <div class="forgot-link has-text-centered">
          <a>Forgot Password?</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
