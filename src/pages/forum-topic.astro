---
import Layout from '../layouts/Default.astro'
const title = 'Forum topic'
---

<Layout title={title}>
  <!-- Main dashboard container -->
  <div
    id="dashboard-wrapper"
    class="dashboard-outer"
    x-data="initForumTopic()"
    x-init="initReplyBox()"
    :class=`{
      'is-pushed': $store.app.sidebarOpenedState,
      '': !$store.app.sidebarOpenedState
    }`
  >
    <div class="dashboard-inner">
      <!-- Dashboard Wrapper -->
      <div class="dashboard-wrapper">
        <div id="main-dashboard" class="section-wrapper">
          <!-- Dashboard content -->
          <div class="dashboard-columns">
            <div class="topic-wrapper">
              <!-- Page title -->
              <div class="forum-title-wrapper is-mobile py-5">
                <img class="forum-image" src="/img/avatars/christina.jpg" alt="" />
                <div class="inner-wrap">
                  <h3 class="forum-title is-topic-title">Payment now supports cryptocurrencies</h3>
                  <div class="title-meta">
                    <div class="meta">
                      <a>Home</a>
                      <i class="material-icons is-breadcrumb">keyboard_arrow_right</i>
                    </div>
                    <div class="meta">
                      <a>Company Annoucements</a>
                      <i class="material-icons is-breadcrumb">keyboard_arrow_right</i>
                    </div>
                    <div class="meta">
                      <span>Topic</span>
                    </div>
                  </div>
                </div>
                <!-- Filter input -->
                <div class="actions">
                  <div class="forum-back">
                    <i class="material-icons">home</i>
                    <i class="material-icons">arrow_back</i>
                  </div>
                  <!-- Forum main dropdown -->
                  <a @click="toggleReplyBox()" class="button is-secondary is-raised" data-ripple-color=""> Reply </a>
                </div>
              </div>

              <!-- Forum Category -->
              <div class="forum-wrap">
                <div class="forum-container">
                  <!-- Heading -->
                  <div class="channel-heading">
                    <h3>Payment now supports cryptocurrencies</h3>
                    <!-- Forum channel dropdown -->
                    <div x-ref="channeldrop" @click.away="$refs.channeldrop.classList.remove('is-active')" class="dropdown is-right dropdown-trigger styled-dropdown is-round">
                      <div @click="$refs.channeldrop.classList.add('is-active')" class="button">
                        <i class="material-icons">more_vert</i>
                      </div>
                      <div class="dropdown-menu is-text-bigger" role="menu">
                        <div class="dropdown-content">
                          <a class="dropdown-item">
                            <i class="material-icons">add</i>
                            <span>
                              <span>New Topic</span>
                              <span>Add a new topic</span>
                            </span>
                          </a>
                          <a href="#" class="dropdown-item">
                            <i class="sl icon-people"></i>
                            <span>
                              <span>Moderators</span>
                              <span>Manage channel moderators</span>
                            </span>
                          </a>
                          <div class="dropdown-divider"></div>
                          <a href="#" class="dropdown-item">
                            <i class="sl icon-bell"></i>
                            <span>
                              <span>Subscribe</span>
                              <span>Subscribe to channel</span>
                            </span>
                          </a>
                          <div class="dropdown-divider"></div>
                          <a class="dropdown-item">
                            <i class="sl icon-trash"></i>
                            <span>
                              <span>Delete</span>
                              <span>Delete this channel</span>
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Topic stats -->
                  <div class="topic-stats">
                    <!-- stat -->
                    <div class="stat-block">
                      <img class="avatar" src="/img/avatars/christina.jpg" alt="" />
                      <div class="stat-meta">
                        <span>Created</span>
                        <span>19 days</span>
