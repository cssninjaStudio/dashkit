          </div>
        </div>
      </div>

      <!-- Post reply form -->
      <div class="reply-box" :class=`{
            'is-active': isReplyActive,
            '': !isReplyActive
        }`>
        <div class="box-inner">
          <div class="columns">
            <div class="column is-8 is-offset-2">
              <form class="reply-form">
                <textarea id="editor" class="textarea" name="reply_content" :placeholder="replyPlaceholder"></textarea>
                <div class="button-wrap">
                  <a @click="toggleReplyBox()" class="button is-secondary is-raised is-rounded ripple ripple-light" data-ripple-color=""> Reply </a>
                  <a @click="toggleReplyBox()" class="button is-rounded ripple" data-ripple-color=""> Cancel </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
