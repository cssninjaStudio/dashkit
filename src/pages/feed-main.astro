---
import Layout from '../layouts/Default.astro'
const title = 'Social Feed'
---

<Layout title={title}>
  <!-- Main dashboard container -->
  <div id="dashboard-wrapper" class="dashboard-outer" x-data="initBlank()" :class=`{
      'is-pushed': $store.app.sidebarOpenedState,
      '': !$store.app.sidebarOpenedState
  }`>
    <div class="dashboard-inner">
      <!-- Dashboard Wrapper -->
      <div class="dashboard-wrapper">
        <div id="main-dashboard" class="section-wrapper">
          <!-- Dashboard content -->
          <div class="dashboard-columns">
            <div class="columns is-multiline">
              <!--Left-->
              <div class="column">
                <!--Menu-->
                <div class="feed-channels">
                  <h3 class="card-heading">Channels</h3>
                  <div class="menu-items">
                    <a class="menu-item is-active">
                      <i class="im icon-Megaphone"></i>
                      <div class="meta">
                        <span>Annoucements</span>
                        <span>Important stuff is here</span>
                      </div>
                    </a>
                    <a class="menu-item">
                      <i class="im icon-Embassy"></i>
                      <div class="meta">
                        <span>Finance</span>
                        <span>The financial channel</span>
                      </div>
                    </a>
                    <a class="menu-item">
                      <i class="im icon-Knight"></i>
                      <div class="meta">
                        <span>Marketing</span>
                        <span>The marketing channel</span>
                      </div>
                    </a>
                    <a class="menu-item">
                      <i class="im icon-Chrysler-Building"></i>
                      <div class="meta">
                        <span>Corporate</span>
                        <span>The corporate channel</span>
                      </div>
                    </a>
                  </div>
                </div>

                <!--Illustration card-->
                <div class="placeholder-card has-text-centered">
                  <img class="light-image-block" src="/img/illustrations/feed.svg" alt="" />
                  <img class="dark-image-block" src="/img/illustrations/feed-dark.svg" alt="" />
                  <h3>Configure Feed</h3>
                  <p>
                    Configure your feed and
                    <a>select the type of contents</a> you'd like to see.
                  </p>
                </div>

                <!-- Widget -->
                <div class="widget list-widget py-2 px-4">
                  <div class="card-head p-4 is-spaced">
                    <h3>Trending</h3>
                    <!--Dropdown-->
                    <div x-ref="menu5" @click.away="$refs.menu5.classList.remove('is-active')" class="dropdown is-right dropdown-trigger styled-dropdown is-round">
                      <div @click="$refs.menu5.classList.add('is-active')" class="button">
                        <i class="material-icons">more_vert</i>
                      </div>
                      <div class="dropdown-menu is-text-bigger" role="menu">
                        <div class="dropdown-content">
                          <a class="dropdown-item">
                            <i class="sl icon-refresh"></i>
                            <span>
                              <span>Reload</span>
                              <span>Reload widget data</span>
                            </span>
                          </a>
                          <a href="#" class="dropdown-item">
                            <i class="sl icon-pencil"></i>
                            <span>
                              <span>Settings</span>
                              <span>Edit widget settings</span>
                            </span>
                          </a>
                          <div class="dropdown-divider"></div>
                          <a href="#" class="dropdown-item">
                            <i class="sl icon-bell"></i>
                            <span>
                              <span>Notifications</span>
                              <span>Notify me of changes</span>
                            </span>
                          </a>
                          <div class="dropdown-divider"></div>
                          <a class="dropdown-item">
                            <i class="sl icon-trash"></i>
                            <span>
                              <span>Delete</span>
                              <span>Delete this widget</span>
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                  <ul class="inner-list is-clean">
                    <li>
                      <div class="list-item-data">
                        <img class="small-avatar" src="/img/logo/companies/airbnb.svg" alt="" />
                        <div class="item-info">
                          <span class="item-title">Airbnb</span>
                          <span>24k followers</span>
                        </div>
                      </div>
                      <div class="item-action">
                        <a class="button">View</a>
                      </div>
                    </li>
                    <li>
                      <div class="list-item-data">
                        <img class="small-avatar" src="/img/logo/companies/alfresco.svg" alt="" />
                        <div class="item-info">
                          <span class="item-title">Alfresco</span>
                          <span>21k followers</span>
                        </div>
                      </div>
                      <div class="item-action">
                        <a class="button">View</a>
                      </div>
                    </li>
                    <li>
                      <div class="list-item-data">
                        <img class="small-avatar" src="/img/logo/companies/amazon.svg" alt="" />
                        <div class="item-info">
                          <span class="item-title">Amazon</span>
                          <span>19k followers</span>
                        </div>
                      </div>
                      <div class="item-action">
                        <a class="button">View</a>
                      </div>
                    </li>
                    <li>
                      <div class="list-item-data">
                        <img class="small-avatar" src="/img/logo/companies/tesla.svg" alt="" />
                        <div class="item-info">
                          <span class="item-title">Tesla</span>
                          <span>16k followers</span>
                        </div>
                      </div>
                      <div class="item-action">
                        <a class="button">View</a>
                      </div>
                    </li>
                    <li>
                      <div class="list-item-data">
                        <img class="small-avatar" src="/img/logo/companies/hm.svg" alt="" />
                        <div class="item-info">
                          <span class="item-title">H&M</span>
                          <span>9k followers</span>
                        </div>
                      </div>
                      <div class="item-action">
                        <a class="button">View</a>
                      </div>
                    </li>
                  </ul>
                </div>
              </div>

              <!--Center-->
              <div class="column is-5">
                <!--Compose-->
                <div class="compose-card is-flex is-start is-vcenter">
                  <figure class="avatar image is-hidden-mobile">
                    <img class="is-circle" src="/img/avatars/helen.jpg" alt="" />
                  </figure>
                  <div class="status-wrapper">
                    <textarea class="textarea" rows="3" placeholder="Write something ..."></textarea>
                  </div>
                  <div class="icon-button">
                    <iconify-icon class="iconify" icon="lucide:upload-cloud"></iconify-icon>
                  </div>
                </div>

                <!-- Feed item-->
                <div class="post-item">
                  <div class="post-header p-5">
                    <div class="is-flex">
                      <img class="feed-avatar" src="/img/avatars/ray.jpg" alt="" />
                      <div class="item-title">
                        <span>Posted by <a href="#">Ray O'Driscol</a></span>
                        <span class="block feed-time-small">45 minutes ago</span>
                      </div>
                      <div x-ref="menu1" class="dropdown is-right dropdown-trigger styled-dropdown is-round" @click.away="$refs.menu1.classList.remove('is-active')">
                        <div @click="$refs.menu1.classList.add('is-active')" class="button">
                          <i class="material-icons">more_vert</i>
                        </div>
                        <div class="dropdown-menu is-text-bigger" role="menu">
                          <div class="dropdown-content">
                            <a class="dropdown-item">
                              <i class="sl icon-refresh"></i>
                              <span>
                                <span>Reload</span>
