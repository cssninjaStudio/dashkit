                              </span>
                            </a>
                            <a href="#" class="dropdown-item">
                              <i class="sl icon-pencil"></i>
                              <span>
                                <span>Settings</span>
                                <span>Edit widget settings</span>
                              </span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="#" class="dropdown-item">
                              <i class="sl icon-bell"></i>
                              <span>
                                <span>Notifications</span>
                                <span>Notify me of changes</span>
                              </span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item">
                              <i class="sl icon-trash"></i>
                              <span>
                                <span>Delete</span>
                                <span>Delete this widget</span>
                              </span>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="post-title">
                      <a href="#">How team building boosts productivity</a>
                    </div>
                    <p class="post-text">Lorem Ipsum is simply dummy text of the printing and typesetting industry Lorem Ipsum is simply dummy text Lorem Ipsum ...</p>
                  </div>

                  <div class="is-flex">
                    <div class="feed-image-container">
                      <div class="soft-overlay"></div>
                      <img src="https://images.pexels.com/photos/1595391/pexels-photo-1595391.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" alt="" />
                      <div x-ref="fabwrap1" class="social-fab">
                        <div class="fab-wrapper">
                          <button x-ref="like1" @click="$refs.like1.classList.toggle('is-active')" class="like fab-btn mini" data-toggle="tooltip" data-placement="left" data-title="Like">
                            <span class="like-wrapper">
                              <i class="material-icons unliked">favorite_border</i>
                              <i class="material-icons liked">favorite</i>
                              <span class="like-overlay"></span>
                            </span>
                          </button>
                          <button class="share fab-btn mini ripple" data-toggle="tooltip" data-placement="top" data-title="Share">
                            <i class="material-icons">share</i>
                          </button>
                          <button class="comment fab-btn mini ripple" data-toggle="tooltip" data-placement="top" data-title="Comment">
                            <i class="material-icons">chat_bubble</i>
                          </button>
                          <button @click="$refs.fabwrap1.classList.toggle('is-open'), $refs.fab1.classList.toggle('is-active')" class="fab-btn pop-fab social-fab-trigger ripple">
                            <span x-ref="fab1" class="plus-toggle">
                              <i class="material-icons">add</i>
                            </span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="is-flex p-5">
                    <div class="is-flex is-start is-vcenter feed-item-footer">
                      <div class="counter-block">
                        <span class="im icon-Heart-2 im-footer"></span>
                        <div class="rating-counter small">31</div>
                      </div>
                      <div class="counter-block">
                        <span class="im icon-Speach-Bubble11 im-footer"></span>
                        <div class="rating-counter small">5</div>
                      </div>
                      <div class="counter-block">
                        <span class="sl icon-paper-clip im-footer"></span>
